{
  "name": "forge-ui-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Production-ready, accessible components for the parts of modern applications developers hate building.",
  "author": "BZDevelopments (https://github.com/bzdevelopments)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:docs": "pnpm --filter @forge-ui/docs build",
    "dev": "pnpm --filter @forge-ui/docs dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4",
    "@changesets/cli": "2",
    "@eslint/js": "9",
    "@playwright/test": "1",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "4",
    "@vitest/coverage-v8": "3",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "6",
    "eslint-plugin-react-hooks": "5",
    "globals": "15",
    "jsdom": "25",
    "prettier": "3",
    "react": "18",
    "react-dom": "18",
    "tsup": "8",
    "turbo": "2",
    "typescript": "5",
    "typescript-eslint": "8",
    "vite": "6",
    "vitest": "3",
    "vitest-axe": "0.1.0",
    "zod": "3.24"
  }
}
