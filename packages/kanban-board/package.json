{
  "name": "@forge-ui/kanban-board",
  "version": "0.2.0",
  "description": "Kanban board with pointer and keyboard drag and drop, card actions, and persistence callbacks.",
  "keywords": [
    "forge-ui",
    "react",
    "accessible",
    "typescript",
    "kanban",
    "drag-and-drop",
    "board"
  ],
  "license": "MIT",
  "author": "BZDevelopments (https://github.com/bzdevelopments)",
  "homepage": "https://github.com/bzdevelopments/forge-ui/tree/main/packages/kanban-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzdevelopments/forge-ui.git",
    "directory": "packages/kanban-board"
  },
  "bugs": {
    "url": "https://github.com/bzdevelopments/forge-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@forge-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
