{
  "name": "@forge-ui/form",
  "version": "0.1.0",
  "description": "Schema-driven form system with multi-step flows, conditional fields, field arrays, and async validation.",
  "keywords": [
    "forge-ui",
    "react",
    "accessible",
    "typescript",
    "forms",
    "validation",
    "react-hook-form",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "BZDevelopments (https://github.com/bzdevelopments)",
  "homepage": "https://github.com/bzdevelopments/forge-ui/tree/main/packages/form#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzdevelopments/forge-ui.git",
    "directory": "packages/form"
  },
  "bugs": {
    "url": "https://github.com/bzdevelopments/forge-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react-hook-form": "^7.53.0",
    "@forge-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
