{
  "name": "@forge-ui/file-uploader",
  "version": "0.1.0",
  "description": "Adapter-based file uploader with validation, previews, progress, retry, cancel, and pause/resume.",
  "keywords": [
    "forge-ui",
    "react",
    "accessible",
    "typescript",
    "file-upload",
    "dropzone",
    "drag-and-drop"
  ],
  "license": "MIT",
  "author": "BZDevelopments (https://github.com/bzdevelopments)",
  "homepage": "https://github.com/bzdevelopments/forge-ui/tree/main/packages/file-uploader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzdevelopments/forge-ui.git",
    "directory": "packages/file-uploader"
  },
  "bugs": {
    "url": "https://github.com/bzdevelopments/forge-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@forge-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
