{
  "name": "@forge-ui/core",
  "version": "0.2.0",
  "description": "Design tokens, hooks, and shared primitives used by every Forge UI component.",
  "keywords": [
    "forge-ui",
    "react",
    "accessible",
    "typescript",
    "design-tokens",
    "hooks",
    "react"
  ],
  "license": "MIT",
  "author": "BZDevelopments (https://github.com/bzdevelopments)",
  "homepage": "https://github.com/bzdevelopments/forge-ui/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzdevelopments/forge-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bzdevelopments/forge-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": {
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
